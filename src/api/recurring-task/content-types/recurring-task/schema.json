{
  "kind": "collectionType",
  "collectionName": "recurring_tasks",
  "info": {
    "singularName": "recurring-task",
    "pluralName": "recurring-tasks",
    "displayName": "Recurring Task",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "overview": {
      "type": "text"
    },
    "garden": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::garden.garden",
      "inversedBy": "recurring_tasks"
    },
    "complete_once": {
      "type": "boolean",
      "default": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "General",
        "Water",
        "Weeding",
        "Planting",
        "Harvest"
      ]
    },
    "schedulers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::scheduler.scheduler",
      "mappedBy": "recurring_task"
    },
    "scheduler_type": {
      "type": "enumeration",
      "enum": [
        "No Schedule",
        "Daily Primary",
        "Weekly Shuffle"
      ],
      "required": true,
      "default": "No Schedule"
    },
    "instruction": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::instruction.instruction"
    },
    "max_volunteers": {
      "type": "integer"
    },
    "primary_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "week_start_date": {
      "type": "enumeration",
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "default": "Sunday",
      "required": false
    },
    "repeat_frequency": {
      "type": "enumeration",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "quarterly"
      ],
      "description": "How often the day's task is made (see src/utils/repeat-schedule.js). Empty means daily, as before repeats existed."
    },
    "repeat_days": {
      "type": "json",
      "description": "Weekday names for weekly and biweekly repeats, e.g. [\"Tuesday\", \"Wednesday\", \"Thursday\"]"
    },
    "repeat_start": {
      "type": "date",
      "description": "First day it can be due. Biweekly counts weeks from here; monthly and quarterly repeat on its day of the month."
    }
  }
}
